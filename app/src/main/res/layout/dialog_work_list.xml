<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingBottom="16dp">
    <LinearLayout style="@style/Widget.Fimtale.BottomSheetHeader"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/workListTitle" style="@style/Widget.Fimtale.BottomSheetTitle"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/workListSort" style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/comments_order_label"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/workList" android:layout_width="match_parent"
            android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="8dp"/>
        <com.fimtale.ui.ShimmerSkeletonView android:id="@+id/workListSkeleton"
            android:layout_width="match_parent" android:layout_height="match_parent"/>
        <com.fimtale.ui.PageErrorView android:id="@+id/workListStatus"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
    <LinearLayout android:id="@+id/workListPager" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:paddingHorizontal="16dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/workListPrevious" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/common_previous_page"/>
        <TextView android:id="@+id/workListPage" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:textColor="?attr/colorOnSurfaceVariant"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/workListNext" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/common_next_page"/>
    </LinearLayout>
</LinearLayout>
