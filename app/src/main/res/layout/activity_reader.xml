<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/readerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ReaderActivity">

    <FrameLayout android:id="@+id/readerContent"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:clipToPadding="false"
            android:scrollbars="none" />
    </FrameLayout>

        <LinearLayout
            android:id="@+id/readerHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvChapterTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/tvChapterProgress"
                    android:layout_marginEnd="8dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/preview_chapter_one"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvChapterProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text=""
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </RelativeLayout>

            <ProgressBar
                android:id="@+id/scrollProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:max="1000"
                android:progress="0"
                android:progressTint="?attr/colorPrimary"
                android:progressBackgroundTint="@android:color/transparent"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/readerFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextClock
                android:id="@+id/tcSystemTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/batteryLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBatteryLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="@string/common_full_percent"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />

                <com.fimtale.ui.icons.MdiImageView
                    android:id="@+id/ivBattery"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:rotation="90"
                    android:contentDescription="@null"
                    app:mdiIcon="battery"
                    app:tint="?android:attr/textColorSecondary" />

                <com.fimtale.ui.icons.MdiImageView
                    android:id="@+id/ivCharging"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@null"
                    android:visibility="gone"
                    app:mdiIcon="lightning-bolt"
                    app:tint="?android:attr/textColorSecondary"
                    tools:visibility="visible" />
            </LinearLayout>

        </LinearLayout>

    <include layout="@layout/view_reader_controls" />

    <FrameLayout
        android:id="@+id/guideOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <com.fimtale.ui.icons.MdiTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/reader_menu_hint"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="16dp"
            android:gravity="center"
            app:mdiDrawableTop="book-open-page-variant"
            android:drawablePadding="8dp"
            app:drawableTint="#FFFFFF"/>

    </FrameLayout>

</FrameLayout>
