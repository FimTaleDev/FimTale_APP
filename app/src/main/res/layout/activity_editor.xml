<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?android:attr/colorBackground">
    <com.fimtale.ui.icons.MdiToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:mdiNavigationIcon="arrow-left" app:menu="@menu/editor_menu"/>
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/editorProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="top" android:paddingHorizontal="20dp" android:paddingVertical="6dp">
        <TextView android:id="@+id/editorStatus" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant"
            android:accessibilityLiveRegion="polite"/>
        <TextView android:id="@+id/editorCharacterCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:maxLines="1" android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/editorRetry" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/editor_retry_load" android:visibility="gone"/>
    <FrameLayout android:id="@+id/editorForm" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone">
        <LinearLayout android:id="@+id/editorWritingPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <ScrollView android:id="@+id/editorScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:fillViewport="true" android:scrollbars="vertical" android:overScrollMode="always">
            <com.fimtale.editor.BbCodeEditorLayout android:id="@+id/editorVisualLayout" android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.fimtale.editor.BbCodeEditText android:id="@+id/editorBody" android:layout_width="match_parent" android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp" android:layout_marginVertical="4dp"
                android:hint="@string/editor_start_writing" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="top|start"
                android:background="@null" android:backgroundTint="@null" app:backgroundTint="@null"
                android:inputType="textMultiLine|textCapSentences" android:imeOptions="flagNoExtractUi" android:textSize="18sp" android:lineSpacingExtra="6dp"
                android:scrollbars="none" android:overScrollMode="never" android:saveEnabled="false"/>
            </com.fimtale.editor.BbCodeEditorLayout>
            </ScrollView>
            <LinearLayout android:id="@+id/editorFormatBar" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingHorizontal="4dp" android:paddingVertical="4dp"
                android:background="?android:attr/colorBackground">
                <com.fimtale.ui.icons.MdiButton android:id="@+id/editorUndo" style="@style/Widget.Fimtale.EditorFormatButton"
                    app:mdiIcon="undo" android:contentDescription="@string/editor_undo" android:tooltipText="@string/editor_undo"/>
                <com.fimtale.ui.icons.MdiButton android:id="@+id/editorRedo" style="@style/Widget.Fimtale.EditorFormatButton"
                    app:mdiIcon="redo" android:contentDescription="@string/editor_redo" android:tooltipText="@string/editor_redo"/>
                <HorizontalScrollView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:scrollbars="none" android:fillViewport="false">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.fimtale.ui.icons.MdiButton android:id="@+id/editorBold" style="@style/Widget.Fimtale.EditorFormatButton"
                    app:mdiIcon="format-bold" android:contentDescription="@string/editor_tool_bold" android:tooltipText="@string/editor_tool_bold"/>
                <com.fimtale.ui.icons.MdiButton android:id="@+id/editorItalic" style="@style/Widget.Fimtale.EditorFormatButton"
                    app:mdiIcon="format-italic" android:contentDescription="@string/editor_tool_italic" android:tooltipText="@string/editor_tool_italic"/>
                <com.fimtale.ui.icons.MdiButton android:id="@+id/editorQuote" style="@style/Widget.Fimtale.EditorFormatButton"
                    app:mdiIcon="format-quote-close" android:contentDescription="@string/editor_tool_quote" android:tooltipText="@string/editor_tool_quote"/>
                <com.fimtale.ui.icons.MdiButton android:id="@+id/editorSpoiler" style="@style/Widget.Fimtale.EditorFormatButton"
                    app:mdiIcon="eye-off-outline" android:contentDescription="@string/editor_tool_spoiler" android:tooltipText="@string/editor_tool_spoiler"/>
                <com.fimtale.ui.icons.MdiButton android:id="@+id/editorEmoji" style="@style/Widget.Fimtale.EditorFormatButton"
                    app:mdiIcon="emoticon-happy-outline" android:contentDescription="@string/editor_tool_emoji" android:tooltipText="@string/editor_tool_emoji"/>
                <com.fimtale.ui.icons.MdiButton android:id="@+id/editorImage" style="@style/Widget.Fimtale.EditorFormatButton"
                    app:mdiIcon="image-outline" android:contentDescription="@string/editor_tool_image" android:tooltipText="@string/editor_tool_image"/>
                <com.fimtale.ui.icons.MdiButton android:id="@+id/editorSource" style="@style/Widget.Fimtale.EditorFormatButton"
                    app:mdiIcon="code-tags" android:contentDescription="@string/editor_show_source_description" android:tooltipText="@string/editor_show_source_description"/>
                </LinearLayout>
                </HorizontalScrollView>
                <com.fimtale.ui.icons.MdiButton android:id="@+id/editorMoreFormats" style="@style/Widget.Fimtale.EditorFormatButton"
                    app:mdiIcon="dots-horizontal" android:contentDescription="@string/editor_more_formats" android:tooltipText="@string/editor_more_formats"/>
            </LinearLayout>
        </LinearLayout>
        <include layout="@layout/editor_metadata"/>
    </FrameLayout>
</LinearLayout>
