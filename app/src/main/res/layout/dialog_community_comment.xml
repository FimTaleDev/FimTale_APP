<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingVertical="8dp">
    <com.fimtale.editor.BbCodeEditText android:id="@+id/communityCommentInput"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minLines="4" android:maxLines="10" android:gravity="top|start"
        android:inputType="textMultiLine|textCapSentences" android:imeOptions="flagNoExtractUi"
        android:hint="@string/community_comment_hint" android:textSize="16sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.fimtale.ui.icons.MdiButton android:id="@+id/communityCommentEmoji"
            style="@style/Widget.Fimtale.EditorFormatButton" app:mdiIcon="emoticon-happy-outline"
            android:contentDescription="@string/editor_tool_emoji" />
        <com.google.android.material.button.MaterialButton android:id="@+id/communityCommentPreview"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="@string/editor_preview" />
    </LinearLayout>
    <TextView android:id="@+id/communityCommentError" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite" android:textColor="?attr/colorError" android:visibility="gone" />
</LinearLayout>
