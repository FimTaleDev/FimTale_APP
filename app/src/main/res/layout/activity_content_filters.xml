<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:clipChildren="false">
    <ScrollView android:id="@+id/filterScroll" android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/filterProgress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorSize="48dp"
                app:trackThickness="4dp" />
            <TextView android:id="@+id/filterCurrent" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="@string/filters_explanation"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/filterDefault" style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/common_default" />
                <com.google.android.material.button.MaterialButton android:id="@+id/filterNone" style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/filters_none" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"
                android:text="@string/filters_custom_title" android:textAppearance="?attr/textAppearanceTitleLarge" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="@string/filters_max_rating" android:textAppearance="?attr/textAppearanceLabelLarge" />
            <Spinner android:id="@+id/filterRating" android:layout_width="match_parent" android:layout_height="52dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="@string/filters_tag_conditions" android:textAppearance="?attr/textAppearanceLabelLarge" />
            <RadioGroup android:id="@+id/filterOperator" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/filterAny" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filters_match_any" android:checked="true" />
                <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/filterAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="@string/filters_match_all" />
            </RadioGroup>
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/filterInvert" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tags_invert_group" />
            <com.fimtale.ui.icons.MdiTextInputLayout android:id="@+id/filterTagLayout" style="@style/Widget.Fimtale.TextInputLayout"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:hint="@string/filters_tag_hint">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/filterTagInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionDone" />
            </com.fimtale.ui.icons.MdiTextInputLayout>
            <com.fimtale.ui.icons.MdiButton android:id="@+id/filterAddTag" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filters_add_tag" app:iconSize="@dimen/mdi_icon_size" app:mdiIcon="tag" />
            <com.google.android.material.chip.ChipGroup android:id="@+id/filterTags" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/filterExpressionSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/filterApply" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/filters_apply" />
                <com.google.android.material.button.MaterialButton android:id="@+id/filterSavePreset" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/filters_save_preset" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"
                android:text="@string/filters_presets" android:textAppearance="?attr/textAppearanceTitleLarge" />
            <LinearLayout android:id="@+id/filterPresets" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <com.fimtale.ui.PageErrorView android:id="@+id/filterPresetEmpty"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"
                android:text="@string/filters_blocked_users" android:textAppearance="?attr/textAppearanceTitleLarge" />
            <com.fimtale.ui.PageErrorView android:id="@+id/filterBlockedEmpty"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone" />
            <LinearLayout android:id="@+id/filterBlocked" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <FrameLayout android:id="@+id/filterToolbarContainer"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:layout_margin="16dp"
        android:clipChildren="false" android:clipToPadding="false">
        <com.google.android.material.card.MaterialCardView android:id="@+id/filterHeaderSurface"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:alpha="0" android:importantForAccessibility="no" android:stateListAnimator="@null"
            app:cardBackgroundColor="?android:attr/colorBackground" app:cardCornerRadius="16dp"
            app:cardElevation="4dp" app:strokeWidth="0dp" />
        <com.fimtale.ui.icons.MdiToolbar android:id="@+id/filterToolbar"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@null" android:elevation="4dp" android:outlineProvider="none"
            android:stateListAnimator="@null" app:mdiNavigationIcon="arrow-left"
            app:navigationIconTint="?attr/colorOnSurface" app:titleTextColor="?attr/colorOnSurface">
            <TextView android:id="@+id/filterToolbarTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/filters_title" android:textColor="?attr/colorOnSurface" android:textSize="21sp" />
        </com.fimtale.ui.icons.MdiToolbar>
    </FrameLayout>
</FrameLayout>
