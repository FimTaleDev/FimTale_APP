<!-- res/layout/grid_item_topic.xml -->
<com.google.android.material.card.MaterialCardView
    style="@style/Widget.Material3.CardView.Outlined"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:rippleColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 关键改动2：让图片填满卡片上半部分，图片的圆角由 CardView 自动裁剪 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.fimtale.ui.ParallaxImageView
                android:id="@+id/coverImageView"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scaleType="matrix"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tagType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="@string/reader_font_label"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_image_tag"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/tagSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="@string/work_author_suffix"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_image_tag"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/tagLength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="@string/reader_medium_size"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_image_tag"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/tagRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="@string/preview_rating"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_image_tag"/>

            </LinearLayout>
        </FrameLayout>

        <!-- 关键改动3：将文字区域放在独立的 LinearLayout 中，保证背景干净 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="@string/preview_long_title" />

            <TextView
                android:id="@+id/authorTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="@string/preview_author" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/tagChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="4dp"
                app:chipSpacingVertical="4dp">
            </com.google.android.material.chip.ChipGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="start|center_vertical"
                android:orientation="horizontal">

                <com.fimtale.ui.icons.MdiTextView
                    android:id="@+id/wordCountTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:mdiDrawableStart="text-box-outline"
                    android:drawablePadding="@dimen/article_stats_icon_text_spacing"
                    android:gravity="center_vertical"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="@string/preview_twelve_k" />

                <com.fimtale.ui.icons.MdiTextView
                    android:id="@+id/viewCountTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:mdiDrawableStart="eye-outline"
                    android:drawablePadding="@dimen/article_stats_icon_text_spacing"
                    android:gravity="center_vertical"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="@string/preview_three_point_five_k" />

                <com.fimtale.ui.icons.MdiTextView
                    android:id="@+id/commentCountTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:mdiDrawableStart="comment-text-outline"
                    android:drawablePadding="@dimen/article_stats_icon_text_spacing"
                    android:gravity="center_vertical"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="@string/preview_one_twenty_eight" />

                <com.fimtale.ui.icons.MdiTextView
                    android:id="@+id/favoriteCountTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:mdiDrawableStart="star-outline"
                    android:drawablePadding="@dimen/article_stats_icon_text_spacing"
                    android:gravity="center_vertical"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="@string/preview_fifty_six" />

            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/topicManageFavorite"
                style="@style/Widget.Fimtale.Interaction" android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_gravity="end" android:visibility="gone" android:text="@string/community_assign_folders" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
