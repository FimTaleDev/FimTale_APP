<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".FimTaleApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fimtale"
        tools:targetApi="31">

        <activity android:name=".ImagePreviewActivity" android:exported="false"
            android:theme="@style/Theme.Fimtale.FullTransparent" />

        <!-- MainActivity 设置为启动页 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Fimtale.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 小说详情页 -->
        <activity
            android:name=".TopicDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Fimtale.FullTransparent" />

        <!-- 历史记录页 -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.Fimtale.FullTransparent" />

        <activity android:name=".ConversationActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.Fimtale.FullTransparent" />
        <activity android:name=".NotificationsActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.Fimtale.FullTransparent" />
        <activity android:name=".ReportDetailActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.Fimtale.FullTransparent" />
        <activity android:name=".MyReportsActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.Fimtale.FullTransparent" />
        <activity android:name=".ReviewQueueActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.Fimtale.FullTransparent" />

        <activity android:name=".account.AccountActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.Fimtale.FullTransparent" />
        <activity android:name=".account.ExamActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.Fimtale.FullTransparent" />
        <activity android:name=".account.PasswordResetActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.Fimtale.FullTransparent" />
        <activity android:name=".channels.ChannelDirectoryActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.Fimtale.FullTransparent" />
        <activity android:name=".channels.ChannelActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.Fimtale.FullTransparent" />
        <activity android:name=".recycle.RecycleActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.Fimtale.FullTransparent" />

        <!-- 收藏页 -->
        <activity android:name=".community.CommentDetailActivity" android:exported="false"
            android:theme="@style/Theme.Fimtale.FullTransparent" />
        <activity android:name=".community.UserContentActivity" android:exported="false"
            android:theme="@style/Theme.Fimtale.FullTransparent" />
        <activity android:name=".community.FollowedTagFeedActivity" android:exported="false"
            android:theme="@style/Theme.Fimtale.FullTransparent" />
        <activity
            android:name=".FavoritesActivity"
            android:exported="false"
            android:theme="@style/Theme.Fimtale.FullTransparent" />

        <!-- 设置页 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Fimtale.FullTransparent" />

        <activity
            android:name=".AccountSessionsActivity"
            android:exported="false"
            android:theme="@style/Theme.Fimtale.FullTransparent" />

        <activity
            android:name=".ContentFiltersActivity"
            android:exported="false"
            android:theme="@style/Theme.Fimtale.FullTransparent" />

        <!-- 阅读页 -->
        <activity
            android:name=".ReaderActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Fimtale.FullTransparent" />

        <!-- 登录页 -->
        <activity android:name=".EditorActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".DraftsActivity" android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Fimtale.FullTransparent" />
        <activity
            android:name=".SiteActivity"
            android:exported="false"
            android:theme="@style/Theme.Fimtale.FullTransparent" />

        <!-- 用户详情页 -->
        <activity
            android:name=".UserDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Fimtale.FullTransparent" />

        <!-- 标签文章列表页 -->
        <activity
            android:name=".TagArticlesActivity"
            android:exported="false"
            android:theme="@style/Theme.Fimtale.FullTransparent" />

        <!-- 标签列表页 -->
        <activity
            android:name=".TagListActivity"
            android:exported="false"
            android:theme="@style/Theme.Fimtale.FullTransparent" />

        <!-- 独立搜索页 -->
        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Fimtale.FullTransparent" />

        <!-- 关于页 -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.Fimtale.FullTransparent" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
